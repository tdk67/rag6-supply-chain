{
  "app": {
    "name": "Aethelgard Infra-GraphRAG",
    "version": "1.0.0",
    "environment": "development"
  },
  "llm": {
    "provider": "openrouter",
    "model": "deepseek/deepseek-v4-flash-0731",
    "base_url": "https://openrouter.ai/api/v1",
    "max_tokens": 4096,
    "temperature": 0.1,
    "timeout_seconds": 45,
    "retries": 3,
    "retry_backoff_seconds": 2,
    "provider_routing": {
      "order": ["Nebius", "Inceptron", "NextBit"],
      "allow_fallbacks": false,
      "data_collection": "deny",
      "zdr": true
    }
  },
  "embedding": {
    "provider": "local",
    "model": "all-MiniLM-L6-v2",
    "dimension": 384
  },
  "chunking": {
    "contracts": {
      "chunk_size": 800,
      "chunk_overlap": 150
    },
    "specifications": {
      "chunk_size": 600,
      "chunk_overlap": 100
    },
    "tables": {
      "chunk_size": 500,
      "chunk_overlap": 100
    },
    "general": {
      "chunk_size": 500,
      "chunk_overlap": 100
    }
  },
  "retrieval": {
    "top_k": 5,
    "similarity_threshold": 0.35,
    "sql_timeout_seconds": 5
  },
  "agent": {
    "max_reflection_passes": 3,
    "query_timeout_seconds": 60,
    "confidence_thresholds": {
      "high": 85,
      "medium": 60,
      "low": 30
    }
  },
  "ports": {
    "vector_store": "chromadb",
    "graph_store": "networkx",
    "llm_provider": "openrouter"
  },
  "paths": {
    "data_dir": "data",
    "generated_dir": "data/generated",
    "documents_dir": "data/documents",
    "chroma_dir": "data/chroma_db",
    "sqlite_db": "data/generated/infrastructure.db",
    "graph_file": "data/generated/knowledge_graph.json",
    "bom_excel": "data/generated/bom_inventory.xlsx",
    "templates_dir": "templates",
    "prompts_dir": "prompts"
  }
}
